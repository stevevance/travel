# Regenerable caches, not sources: Overpass/Valhalla responses and tile scratch.
*.pyc
__pycache__/
.venv/
src/**/*.json
src/**/tilecache/

# Raw GPS traces stay local. The maps draw a simplified, trimmed version of the
# ride; the one-second original is finer than anything published and this repo
# is public. Keep the file alongside the notes in data/ to rebuild.
data/**/*.gpx

# Screenshots from the shoot.py checks. Regenerable, and large.
*_check.png
*_check_photo.png

# The one coordinate this repo must not publish: the radius around home that
# the two Rotterdam rides are clipped to. build.py needs it; git must not have it.
data/**/private.json
